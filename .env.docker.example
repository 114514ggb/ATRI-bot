# 复制为 .env 后按需修改：cp .env.docker.example .env

# ---------------- 数据库 ----------------
ATRI_DB_SUPERUSER_PASSWORD=180710
# 应用连接的库名（会写进运行时配置的 database.database）；改这里时要保证 db 容器初始化用的是同名库
ATRI_DB_NAME=atri
ATRI_DB_APP_USER=atri
ATRI_DB_APP_PASSWORD=180710
# 数据库端口只绑定宿主机 127.0.0.1；要从其他机器连库请改 docker-compose.yml 的端口映射
ATRI_DB_PORT_FORWARD=5432

# ---------------- Bot 与 NapCat ----------------
ATRI_BOT_PORT=8888
ATRI_ACCESS_TOKEN=ATRI114514
# 仅 WebSocket_client（客户端模式）使用；默认的 server 模式会忽略
ATRI_NAPCAT_URL=host.docker.internal:3001

# ---------------- Web 管理面板 ----------------
# 容器内监听 0.0.0.0，宿主访问 http://localhost:<ATRI_PANEL_PORT>/admin/
# （compose 默认只把端口绑到宿主机回环地址，远程访问请自行调整端口映射）
ATRI_PANEL_PORT=5308
# 面板登录口令（必填，compose 未设置会直接报错）：
#   - 优先级：assets/config.json 的 web_panel.access_token > 本变量，两边都配时以配置文件为准
#   - 建议 32 字符以上随机值：python -c "import secrets; print(secrets.token_urlsafe(32))"
#   - 登录页用该口令换取会话令牌（默认 4 小时有效，web_panel.session_ttl_hours 可调）；修改口令会踢出全部已登录会话
#   - 连续输错 3 次触发全局锁定（10 分钟起步、指数递增、封顶 24 小时；锁定期间正确口令也拒绝）
ATRI_PANEL_TOKEN=

# ---------------- 沙盒 ----------------
# 需要先手动构建镜像（不构建不阻断启动，但 AI 的代码执行能力会缺失）：
#   docker build -t atri-sandbox:latest -f atribot/LLMchat/sandbox/Dockerfile .
ATRI_SANDBOX_IMAGE=atri-sandbox:latest

# ---------------- 构建加速 ----------------
# 构建阶段用的 Debian 源与 PyPI 源；国内网络建议换成镜像站
ATRI_APT_MIRROR=deb.debian.org
ATRI_PIP_INDEX_URL=https://pypi.org/simple

# ---------------- 其它 ----------------
# 1 = 同时写文件日志（挂载在 ./atribot/log）；0 = 只输出 stdout，交给 docker 日志轮转
ATRI_FILE_LOG=1
TZ=Asia/Shanghai

# ---------------- 平台覆盖 ----------------
# .env 会整体注入 app 容器，ATRI_PLATFORM_<平台名>_<字段> 由 docker/python/prepare_config.py
# 写入运行时配置 platforms.<平台名>.<字段>。
# 字段：adapter / connection_type / access_token / url / host / port / source_name / enabled
# 示例：本机 config.json 里还开着 snowluma 时，容器内会对着 127.0.0.1:3001 一直重连，
# 跑 NapCat 部署时建议在 .env 里关掉：
# ATRI_PLATFORM_SNOWLUMA_ENABLED=false

# ---------------- 路径映射（Docker 部署必配）----------------
# napcat 跑在宿主机时，bot 发出的 file:// 路径是容器内路径（/app/...），宿主读不到，
# 需要在宿主机的 assets/config.json 里配置 file_path.path_mapping，例如：
#   "path_mapping": { "/app/document": "<宿主机 document 绝对路径>", "/app/assets": "<宿主机 assets 绝对路径>" }
# 不配置的症状：TTS 语音、表情包、本地图片/文件发送失败（NapCat 报文件不存在）